# =========================================================================
# Quick-start for the no-auth demo (DEMO_NO_AUTH=1)
# =========================================================================
# To run the end-to-end demo without configuring Google OAuth, set:
#
#     DEMO_NO_AUTH=1
#
# and fill in ONLY these variables:
#
#   - DATABASE_URL          (Postgres for Prisma; local or Neon both work)
#   - OPENAI_API_KEY        (co-pilot chat, Whisper transcripts, summaries)
#   - INTERHUMAN_API_KEY    (live social-signal stream — core to the demo)
#   - BLOB_READ_WRITE_TOKEN (Vercel Blob, where recordings are uploaded)
#   - NEXT_PUBLIC_APP_URL   (defaults are fine for `pnpm dev`)
#
# You can leave the AUTH_* block empty in this mode. A single shared
# "Demo Researcher" user is auto-upserted and used for all researcher
# actions; respondents are anonymous regardless.
# =========================================================================

# --- Database (Vercel Postgres / Neon) ---  [REQUIRED, even in DEMO_NO_AUTH]
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# --- NextAuth (Auth.js v5) ---  [SKIP when DEMO_NO_AUTH=1]
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Optional in dev; required when behind a proxy/HTTPS in prod
AUTH_URL="http://localhost:3000"

# Google OAuth — create at https://console.cloud.google.com/apis/credentials
# [SKIP when DEMO_NO_AUTH=1]
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- OpenAI ---  [REQUIRED, even in DEMO_NO_AUTH]
OPENAI_API_KEY=""

# --- Interhuman ---  [REQUIRED, even in DEMO_NO_AUTH]
INTERHUMAN_API_KEY=""
# Optional override; defaults to wss://api.interhuman.ai/v1/stream/analyze
INTERHUMAN_STREAM_URL=""

# --- Vercel Blob ---  [REQUIRED, even in DEMO_NO_AUTH]
BLOB_READ_WRITE_TOKEN=""

# --- Public app URL (used for share links shown in the UI) ---
# [REQUIRED — defaults below are fine for local `pnpm dev`]
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Demo mode ---
# Set to 1 to bypass Google sign-in entirely. A single shared "Demo Researcher"
# user is auto-upserted and used for all researcher actions. Respondents are
# already anonymous, so they're unaffected. Do not enable in production.
DEMO_NO_AUTH="0"
