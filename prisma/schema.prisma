generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- NextAuth (Auth.js v5) ---
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  researches    Research[]
  createdAt     DateTime  @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Domain ---
enum ResearchStatus {
  draft
  live
  closed
}

model Research {
  id             String         @id @default(cuid())
  slug           String         @unique
  title          String
  topic          String         @default("")
  description    String         @default("")
  status         ResearchStatus @default(draft)
  includeOptions Json           @default("[\"conversation_quality_overall\", \"conversation_quality_timeline\"]")
  creatorId      String
  creator        User           @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  questions      Question[]
  chatMessages   ChatMessage[]
  submissions    Submission[]
  summary        ResearchSummary?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([creatorId])
}

model Question {
  id          String     @id @default(cuid())
  researchId  String
  research    Research   @relation(fields: [researchId], references: [id], onDelete: Cascade)
  order       Int
  prompt      String
  helperText  String     @default("")
  maxSeconds  Int        @default(90)
  answers     Answer[]
  createdAt   DateTime   @default(now())

  @@index([researchId, order])
}

enum ChatRole {
  system
  user
  assistant
}

model ChatMessage {
  id         String   @id @default(cuid())
  researchId String
  research   Research @relation(fields: [researchId], references: [id], onDelete: Cascade)
  role       ChatRole
  content    String   @db.Text
  createdAt  DateTime @default(now())

  @@index([researchId, createdAt])
}

enum SubmissionStatus {
  in_progress
  finished
  abandoned
}

model Submission {
  id                  String           @id @default(cuid())
  researchId          String
  research            Research         @relation(fields: [researchId], references: [id], onDelete: Cascade)
  respondentNickname  String?
  userAgent           String?
  streamSessionId     String?
  status              SubmissionStatus @default(in_progress)
  summary             Json?
  answers             Answer[]
  createdAt           DateTime         @default(now())
  finishedAt          DateTime?

  @@index([researchId, createdAt])
}

model Answer {
  id                  String     @id @default(cuid())
  submissionId        String
  submission          Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId          String
  question            Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  blobUrl             String?
  durationMs          Int?
  // Streaming session bookkeeping (absolute session-cumulative seconds)
  streamSessionId     String?
  streamStartSeconds  Float?
  streamEndSeconds    Float?
  // Whisper verbose_json
  transcript          String?    @db.Text
  transcriptSegments  Json?
  // Interhuman envelopes
  signals             Json?
  engagement          Json?
  conversationQuality Json?
  correlationId       String?
  // GPT summary (per-answer)
  summary             Json?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@unique([submissionId, questionId])
  @@index([questionId])
}

model ResearchSummary {
  id          String   @id @default(cuid())
  researchId  String   @unique
  research    Research @relation(fields: [researchId], references: [id], onDelete: Cascade)
  body        Json
  generatedAt DateTime @default(now())
}
